# Copy this file to .env for local runs. Never commit .env.
# On GitHub, add the keys as Actions secrets instead (see the README).

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Upload-Post (https://upload-post.com): API key and the profile name your accounts are connected to
UPLOADPOST_API_KEY=
UPLOADPOST_PROFILE=

# Do everything except call Upload-Post (and except write files, for the draft step)
DRY_RUN=false

# Mark every new draft "needs-answer", so you confirm each one by hand
REVIEW_MODE=false
